# Host user that owns ./data. setup.sh fills these from id -u / id -g.
PUID=1000
PGID=1000

# Web UI. Bind to 127.0.0.1 when a reverse proxy owns the public port.
LANPARTY_WEB_BIND=0.0.0.0
LANPARTY_WEB_PORT=8080

# UDP port used by the host tunnel and game traffic. Forward this on the router.
LANPARTY_APP_PORT=51820

# Optional: serve HTTPS directly from the container. Files live in ./tls.
# Leave both blank to use plain HTTP behind a reverse proxy.
# LANPARTY_WEB_TLS_CERT=/tls/cert.pem
# LANPARTY_WEB_TLS_KEY=/tls/key.pem

# Optional: trust X-Forwarded-* only from these proxy addresses.
# LANPARTY_WEB_TRUSTED_PROXIES=127.0.0.1/32
