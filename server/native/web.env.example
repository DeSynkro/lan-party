# Consumed by the optional systemd unit or run.sh.
# Keep this file at mode 0600: it names the data directory and listen address.
LANPARTY_WEB_LISTEN=0.0.0.0:8080
LANPARTY_APP_PORT=51820

# Optional direct TLS. Files must be readable by the service user.
# LANPARTY_WEB_TLS_CERT=/etc/lan-party-web/cert.pem
# LANPARTY_WEB_TLS_KEY=/etc/lan-party-web/key.pem

# Optional reverse proxy addresses allowed to set X-Forwarded-*.
# LANPARTY_WEB_TRUSTED_PROXIES=127.0.0.1/32
