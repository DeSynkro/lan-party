# Copy to .env and adjust for your machine.

# The address friends and the host app use to reach this relay. It is written
# into the host profile. On a VPS, set your public hostname or IP here.
LANPARTY_RELAY_PUBLIC_ADDRESS=127.0.0.1:7443

# Host port mapped to the relay's internal 7443 (TCP and UDP).
# If you change this, enter the same public port above.
LANPARTY_RELAY_PORT=7443

# Optional version label for a source-checkout local build.
#LANPARTY_RELAY_VERSION=1.2.0-dev

# Optional. Set before the first start to choose your own relay password.
# If empty, a strong password is generated and written to the host profile.
#LANPARTY_RELAY_PASSWORD=
