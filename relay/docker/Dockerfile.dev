# Source-checkout image, built automatically by compose.override.yaml.
# The release zip uses the prebuilt binary with Dockerfile instead.
FROM golang:1.27.4 AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/lan-party-relay ./cmd/lan-party-relay
COPY internal/relay ./internal/relay
COPY internal/buildinfo ./internal/buildinfo
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
    -ldflags "-s -w -X github.com/desynkro/lan-party/internal/buildinfo.Version=${VERSION}" \
    -o /out/lan-party-relay ./cmd/lan-party-relay

FROM busybox:1.36 AS data
RUN mkdir -p /data && touch /data/.keep

FROM gcr.io/distroless/static-debian12:nonroot
ARG VERSION=dev
LABEL org.opencontainers.image.title="LAN Party Relay"
LABEL org.opencontainers.image.description="Opaque UDP relay for LAN Party host and friend connections"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.licenses="GPL-3.0-only"
LABEL org.opencontainers.image.source="https://github.com/DeSynkro/lan-party"
LABEL org.opencontainers.image.url="https://github.com/DeSynkro/lan-party"

COPY --from=data --chown=65532:65532 /data /data
COPY --from=build --chown=65532:65532 /out/lan-party-relay /lan-party-relay

WORKDIR /data
USER 65532:65532
EXPOSE 7443/tcp
EXPOSE 7443/udp
ENTRYPOINT ["/lan-party-relay"]
CMD ["run"]
