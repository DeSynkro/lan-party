# Optional overrides for lan-party-relay.service.
# The built-in default already points at the native install layout.
#LANPARTY_RELAY_CONFIG=/etc/lan-party-relay/relay.json

# Optional. When set, the relay applies these to the config and host profile on
# each start without rotating the identity or password.
#LANPARTY_RELAY_PUBLIC_HOST=relay.example.net
#LANPARTY_RELAY_PUBLIC_PORT=7443
